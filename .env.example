# ==============================================================================
# Open Travel Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Express API Backend (Render / Railway / Server)
# ------------------------------------------------------------------------------
# MongoDB connection URI (e.g. from MongoDB Atlas)
DATABASE_URL="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/opentravel?retryWrites=true&w=majority"

# Shared secret header key to authorize Next.js requests to Express API (x-internal-key)
INTERNAL_API_KEY="generate-a-long-random-string-here"

# Port (Render/Railway sets PORT automatically)
PORT=4000
HOST="0.0.0.0"

# ------------------------------------------------------------------------------
# 2. Next.js Frontend (Vercel)
# ------------------------------------------------------------------------------
# Publicly accessible URL of the deployed Express backend (no trailing slash)
API_URL="https://your-api-service.onrender.com"

# NextAuth session encryption key
AUTH_SECRET="generate-with: openssl rand -base64 32"
AUTH_TRUST_HOST=true

# Public URL of the frontend (e.g. https://your-domain.vercel.app)
AUTH_URL="https://your-domain.vercel.app"

# Firebase Client (Google sign-in) — from Firebase Console > Project settings > General
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# Firebase Admin SDK (Server-side ID token verification)
# From Firebase Console > Project settings > Service accounts > Generate new private key
# Paste the minified single-line JSON string:
FIREBASE_SERVICE_ACCOUNT=""